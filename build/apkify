#!/zshctl/bin/zshctl

function apkify {
    typeset version=$(zsh compiled/zshctl version)
    whoami
    mkdir -p ~/.abuild
    ls -la ~/.abuild
    mkdir -p /html
    mkdir -p ~/packages
    git config --global user.name "Alan Gutierrez"
    git config --global user.email "alan@prettyrobots.com"
    git config --global init.defaultBranch main
    mkdir origin.git
    git -C origin.git init
    cp compiled/zshctl origin.git/zshctl
    git -C origin.git add .
    git -C origin.git commit -m 'Sketch.'
    git clone ./origin.git
    cp /run/secrets/rsa ~/.abuild/alan@prettyrobots.com-67eee297.rsa
    openssl rsa -in /run/secrets/rsa -pubout -out ~/.abuild/alan@prettyrobots.com-67eee297.rsa.pub
    heredoc <<'    EOF' > ~/.abuild/abuild.conf
    PACKAGER_PRIVKEY=$HOME/.abuild/alan@prettyrobots.com-67eee297.rsa
    PACKAGER="Alan Gutierrez <alan@prettyrobots.com>"
    MAINTAINER="$PACKAGER"
    REPODEST=$HOME/packages
    EOF
    pushd origin
    heredoc -f $version  <<'    EOF' >> APKBUILD
    # Maintainer: Alan Gutierrez <alan@prettyrobots.com>
    pkgver=%s
    pkgname=zshctl
    pkgrel=0
    pkgdesc="ZSH CLI application framework."
    url="https://zshctl.sh/"
    arch="noarch"
    license="ISC"
    depends="zsh less groff"
    depends_dev=""
    #makedepends=""
    install=""
    subpackages=""
    source="zshctl"
    builddir="$srcdir/$pkgname-$pkgver"

    prepare() {
        default_prepare
    }

    build() {
        true
    }

    check() {
        true
    }

    package() {
        mkdir -p "$pkgdir/usr/bin"
        cp zshctl "$pkgdir/usr/bin"
    }
    EOF
    abuild checksum || abend '`abuild checksum` failed'
    abuild -r || abend '`abuild -r` failed'
    popd
    mkdir -p /html/apk/x86_64
    # TODO Can I make this a no-arch package?
    if [[ ! -e previous/zero ]]; then
        cp previous/apk/x86_64/*.apk html/apk/x86_64
    fi
    cp /home/build/packages/work/x86_64/zshctl-$version-r0.apk /html/apk/x86_64
    pushd /html/apk/x86_64
    apk index --no-warnings -vU -o APKINDEX.tar.gz *.apk
    popd
    abuild-sign -k ~/.abuild/alan@prettyrobots.com-67eee297.rsa /html/apk/x86_64/APKINDEX.tar.gz
    openssl rsa -in /run/secrets/rsa -pubout -out /html/alan@prettyrobots.com-67eee297.rsa.pub
}

