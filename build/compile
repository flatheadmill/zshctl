#!/zshctl/bin/zshctl

function compile {
    # Get the seconds since the epoch of the commit.
    date=$(git -C /zshctl show --no-patch --format=%ct)
    # Compile `zshctl`.
    /zshctl/bin/zshctl compile -d $date -v $ZSHCTL_NEXT_VERSION > zshctl
    # Create a tarball containing only `zshctl`.
    tar -czvf zshctl-$ZSHCTL_NEXT_VERSION.tar.gz zshctl
    gpg --import /run/secrets/gpg
    gpg --list-secret-keys --keyid-format=long
    gpg --armor --export 'Package Signing' > gpg
}

