#!/usr/bin/env zsh

# Currently working on separating argument parsing from completions and I
# believe there was something in my mind about how completions address a gap
# in zshctl functionality, some extra feature to feel contemporary, but has no
# obvious solution at the moment.
#
# So we must remember that we had a first pass at a completion system, and a
# number of passes at argument parsing, and we're not ready to address more
# complexity based on what we discovered from our work so far.
#
# It would be nice to have the kubernetes way of having arguments at any point
# along the path, where `--namespace` immediately follows `kubectl` or comes
# after `get pod hello` but it doesn't make much sense when an application
# uses the extend functionality, or maybe it could, depending on the
# application, and if really doesn't make sense, then don't use it.
#
# While `zshctl` is supposed to provide structure, it's not really a framework
# like Cobra that seeks to turn your program into disassociated functions
# receiving payloads. Not sure why I'm focused on Cobra, the scrambled
# arguments are a Go fetish, and we survived for half a century without them.

zmodload zsh/parameter

typeset -xgA zshctl

zshctl[man_title]='Zshctl Manuals'
zshctl[shebangable]=1
zshctl[commandable]=1
zshctl[extensible]=1
zshctl[localized]=1
zshctl[main]=zshctl

# Invoke the next sub-command from the extracted commands. The prefix is the
# underbar delimited path of commands visited so far.
function delegate {
    typeset next=${1:-}
    integer top=2
    while [[ $funcstack[$top] != (:execute:*|:execute) ]]; do
        ((top++))
        (( top <= ${#funcstack} )) || abend 'must be called from an execute function'
    done
    typeset func=$funcstack[$top]
    # TODO More here, basically, if the top most argument doesn't match when
    # completing, then complete, otherwise we have an error and cannot answer.
    if (( ! $# )) || [[ -z ${1:-} ]]; then
        (( parse[complete] )) && return
        abend 'fatal: %s expects a command argument' ${func//:/ }
    fi
    typeset delegate=$func:$next
    shift
    if [[ ${${zshctl[$delegate]}[1]} = '/' ]]; then
        source $zshctl[$delegate]
        (( ${+functions_source[$delegate]} )) ||
            abend 'unable to source `%s`.' $delegate
        zshctl[$delegate]=':'
    fi
    (( ${+functions_source[$delegate]} )) ||
        abend 'fatal: no such command `%s`.' ${delegate//:/ }
    _zshctl_execute $delegate "$@"
}

# Default execution simply delegates.
function :execute {
    delegate "$@"
}

# For completions, we do not have to invoke delegate, we can instead look at
# the functions_source map to determine if there are additional extension
# commands, which I believe we are doing in any case to fill out sub-commands
# in help. For simplicities sake, on the execution path, the invocation of
# delegate must be explicit. That is, the `:execute:*` function  is not
# optional, you must provide one even if all it does invoke `delegate`.

# Note that `:args` and `:args:*` are optional since some zshctl programs are
# container programs that are invoked with environment variables only, so the
# parser and completion system are not necessary.

function _zshctl_execute {
    typeset func=${1:-}
    shift
    typeset args=${func/#:execute/:args}
    typeset complete=${args/#:args/:complete}
    zshctl+=( args:func $func args:mode execute args:complete 0 )
    if (( ${+functions[$args]} )); then
        $args "$@"
    elif (( ${+functions[$args]} )); then
        $func "$@"
    else
        abend -c 2 'fatal: invalid argument: no such command'
    fi
}

# I can imagine that what we want from the args function is indeed all the
# values set so far, such as o_namespace, so we can better complete, plus
# whereever we got stuck, so that when we do call a completion function all
# the existing properties are defined, so it is much the same, but we do not
# call any function except the last completion function.
#
# We do not want to abend on a missing argument, either.

function _zshctl_descend_completion {
    typeset sofar=${1:-} args
    shift
    typeset args="$sofar:${1-}"
    typeset delegate=${args//#:args/:execute}
    typeset complete=${args//#:args/:complete}
    if [[ ${${zshctl[$delegate]}[1]} = '/' ]]; then
        source $zshctl[$delegate]
        (( ${+functions_source[$delegate]} )) ||
            abend 'unable to source `%s`.' $delegate
        zshctl[$delegate]=':'
    fi
    if (( $# && ${+zshctl[$delegate]} )); then
        shift
        zshctl+=( args:mode completion args:complete 1 )
        $args "$@"
    else
        typeset -A completions=()
        typeset completion_match=()
        [[ $sofar != :args ]] && zshctl[args:command]=${zshctl[args:command]}${${sofar#:args}//:/-}
        complete=${sofar//#:args/:complete}
        if (( ${+functions[$complete]} )); then
            $complete "$@"
        fi
        if [[ $zshctl[args:kind] = none ]]; then
            _zshctl_completions $sofar
            if (( ! ${#completion_match} )); then
                zshctl[args:state]=nothing
            elif [[ $zshctl[args:incomplete] != -* ]]; then
                zshctl[args:state]='command'
            fi
        fi
        _zshctl_completed
    fi
}

function _zshctl_completed {
    local key
    for key in ${(@ko)zshctl}; do
        [[ $key = args:* && $key != args:(debug) ]] || continue
        key=${key#args:}
        printf 'settings[%s]=%s\n' $key "${(@qq)zshctl[args:$key]}"
    done
    for key in "${(@)completion_match}"; do
        [[ $zshctl[args:incomplete] != -* && $key = -* ]] && continue
        printf 'completions+=( %s )\n' ${(qq)key}
        if (( ${+completions[$key]} )); then
            printf 'settings[_key]=%s; descriptions[${settings[_key]}]=%s\n' \
                ${(qq)key} ${(qq)completions[$key]}
        fi
    done
}

function _zshctl_completion_arguments {
    typeset next=${1:-} words=()
    zshctl+=( args:debug ${2:-/dev/null} )
    typeset -i cword=${3:-}
    shift 3
    typeset words=( "${@[2,$cword]}" )
    shift $cword
    typeset -i current=${1:-}
    shift
    ((current--))
    zshctl[args:incomplete]=$words[$current]
    ((current--))
    words=( "${(@)words[1,$current]}" )
    $next "$@"
}

# Meant to be called from our completion functions, so no defensive programming
# as of yet.
function _zshctl_complete {
    zshctl+=( args:kind none args:mode completion 'args:command' ${zshctl[argzero]:A:t} )
    _zshctl_descend_completion '' args "${(@)words}"
}

function _zshctl_encache {
    zshctl+=( args:debug ${1:-/dev/null} args:kind none )
    typeset encache=${2:-}
    shift 2
    typeset func=${encache//#:encache/:execute}
    if [[ ${${zshctl[$func]}[1]} = '/' ]]; then
        source $zshctl[$func]
        (( ${+functions_source[$func]} )) || abend 'unable to source `%s`.' $func
        (( ${+functions_source[$enache]} )) || abend 'unable to source `%s`.' $enache
        zshctl[$func]=':'
    fi
    typeset -A completions=()
    typeset completion_match=()
    $encache "$@"
    _zshctl_completed
}

function {
    integer is_zshctl=1
    typeset command_path=() match=()
    typeset shebang dir base func src
    zshctl[argzero]=$ZSH_ARGZERO
    # Shebang check. Do not be surprised when a file is sourced when you type
    # `zshctl foo` if `foo` exists in the current directory and it has a
    # zshctl shebang line. It feels like a security risk, and perhaps it is,
    # but it's not much different from typing `zsh foo`.
    while
        if (( $zshctl[commandable] )); then
            command_path+=( "${zshctl[argzero]:A:h:h}/share/${zshctl[argzero]:t}" )
        fi
        zshctl[program]=${zshctl[argzero]:t}
        shebang=$1
        if (( $# && zshctl[shebangable] )) && [[
            ( $shebang =~ ^\. || $shebang =~ / ) &&
            -f $shebang &&
            (
                (
                    "$(head -c 14 $shebang)" = '#!/usr/bin/env' &&
                    "$(head -n 1 $shebang)" =~ ^#!/usr/bin/env\ +([^ ]+)\ *$ &&
                    $match[1] = ${zshctl[argzero]:t}
                ) ||
                (
                    "$(head -n 1 $shebang)" =~ ^#!(/[^ ]+)\ *$ &&
                    $match[1] = $zshctl[argzero]
                )
            )
        ]]; then
            zshctl[argzero]=$1
            shift
            zshctl[shebangable]=0
            is_zshctl=0
            source ${zshctl[argzero]:A}
            true
        else
            false
        fi
    do; :; done
    # The `localized` flag means that we will extend our programs with
    # extension commands and includes in our ~/.local directory. (We could
    # also extend from /usr/share/, but not today.)
    if (( zshctl[commandable] )); then
        if (( zshctl[extensible] )); then
            command_path+=( ~/.local/share/${zshctl[program]}/extensions/*(N) )
            if (( zshctl[localized] )); then
                command_path+=( ~/.local/share/${zshctl[program]}/extensions/*(N) )
            fi
        fi
    fi
    # Preserve the system fpath for a systemload function.
    zshctl[fpath]=$fpath
    # The value for uncompiled functions is the path to the source, so we use
    # ":" in functions as separators because it is the POSIX path separator.
    for dir in "${(@)command_path}"; do
        # Definitive list of available commands. Maps `:execute:*` function name
        # to the source file or to `:` after the file is sourced. When sourced,
        # you can find the source file in the `functions_source` associative
        # array. Note that `${+functions_source[does_not_exist]}` always returns
        # `1`, even if the function does not exist, so we rely on `zshctl` to
        # determine command existance.
        for src in "$dir"/commands/**/command.zsh(N); do
            func=${${src#$dir/commands/}%/command.zsh}
            zshctl[:execute:${func//\//:}]=$src
        done
        # Add all functions to out autoload path.
        fpath=( "$dir"/functions $fpath )
        for src in "$dir"/functions/*(N.); do
            autoload -zU ${src:t}
        done
        # Recall that we need to autoload our version info generated when we
        # create a release.
        for src in $dir/release.zsh(N); do
            source $src
        done
    done
    # Mark the default `:execute` function as sourced.
    zshctl[:execute]=:
    # Mark functions that were sourced by the shebang program as extant and
    # sourced.
    for func in "${(@k)functions_source}"; do
        [[ $func = :execute:* ]] || continue
        _zshctl_commands[$func]=':'
    done
    # Create a stub `:complete` function if we were not invoked by shebang.
    if (( is_zshctl )); then
        function :args {
            eval "$(args -UD -bx h,help -- "$@")"
        }
        function :help {
            heredoc -v help <<'            EOF'
                # terse
                a structure for Zsh programs
                # opt help
                Display help for `zshctl`.
                # man
                ## DESCRIPTION
                a structure for the creation of Zsh programs.

                `zshctl` provides underlying structure for Zsh programs with an argument parser,
                a system for nested commands, a system for includes, and some libraries.
                ## OPTIONS
                > options
                ## COMMANDS
                The following commands can be invoked to manage `zshctl` resources.
                You can learn more about the each command with the `--help` option.
                > commands
            EOF
        }
    fi
    # `__complete` is a special argument passed by completions, so we follow
    # the completion path for it, otherwise the execute path.
    case ${1:-} in
    (__complete)
        shift
        _zshctl_completion_arguments _zshctl_complete "$@"
        ;;
    (__encache)
        shift
        _zshctl_encache "$@"
        ;;
    (__mandown|__man)
        zshctl+=( help:mode ${1:-} )
        shift
        ;&
    (*)
        _zshctl_execute :execute "$@"
        ;;
    esac
} "$@"
