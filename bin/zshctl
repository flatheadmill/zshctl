#!/usr/bin/env zsh

zmodload zsh/parameter

typeset -xgA zshctl

zshctl[man_title]='Zshctl Manuals'
zshctl[shebangable]=1
zshctl[commandable]=1
zshctl[main]=zshctl

function include {
    while (( $# )); do
        case "${INCLUDES[$1]}" in
            /* )
                source $INCLUDES[$1]
                INCLUDES[$1]=':'
                ;;
            : )
                ;;
            * )
                abend 'unable to include %s' "${(qqq)1}"
        esac
        shift
    done
}

function execute {
    eval "$(args -F -bx h,help -- "$@")"
    delegate "$@"
}

function {
    typeset -A INCLUDES=() COMMANDS=()
    typeset include_path=() command_path=() match=()
    typeset shebang dir base func src
    zshctl[argzero]=$ZSH_ARGZERO
    while
        include_path+=( ${zshctl[argzero]:A:h:h} )
        if (( $zshctl[commandable] )); then
            command_path+=( "${zshctl[argzero]:A:h:h}/share/${zshctl[argzero]:t}" )
        fi
        zshctl[program]=${zshctl[argzero]:t}
        shebang=$1
        if (( $# && zshctl[shebangable] )) && [[
            ( $shebang =~ ^\. || $shebang =~ / ) &&
            -f $shebang &&
            (
                (
                    "$(head -c 14 $shebang)" = '#!/usr/bin/env' &&
                    "$(head -n 1 $shebang)" =~ ^#!/usr/bin/env\ +([^ ]+)\ *$ &&
                    $match[1] = ${zshctl[argzero]:t}
                ) ||
                (
                    "$(head -n 1 $shebang)" =~ ^#!(/[^ ]+)\ *$ &&
                    $match[1] = $zshctl[argzero]
                )
            )
        ]]; then
            zshctl[argzero]=$1
            shift
            zshctl[shebangable]=0
            source ${zshctl[argzero]:A}
            true
        else
            false
        fi
    do; :; done
    # The value for uncompiled functions is the path to the source, so we use
    # ":" functions because it is not a popular file name.
    for dir in "${(@)command_path}"; do
        base=${zshctl[argzero]:A:h:h}/share/${zshctl[argzero]:t}
        for src in "$base"/*/commands/**/command.zsh(N); do
            func=${${src#$base/*/commands/}%/command.zsh}
            COMMANDS[execute:$func]=$src
        done
        for src in "$base"/*/include/*.zsh(N); do
            INCLUDES[${src:t:r}]=$src
        done
        for src in $base/release.zsh(N); do
            source $src
        done
    done
    for func in "${(@k)functions_source}"; do
        [[ $func = execute:* ]] || continue
        COMMANDS[$func]=':'
    done
    include parse
    execute "$@"
} "$@"
