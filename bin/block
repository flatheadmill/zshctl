#!/usr/bin/env zsh

source ${ZSH_ARGZERO:A:h:h}/lib/block.zsh

function {
    [[ $1 = toplevel ]] || return
    source ${ZSH_ARGZERO:A:h}/heredoc.zsh
    typeset -A o_block
    banner zsh
    {
        show eval '('
        print $?
    } always {
        caught
    } > >(indent)
    banner stop
    {
        show <<'        EOF'
            print called && stop finis
        EOF
        print continued
    } always {
        print catching
        okay && print okay
        caught
    } > >(indent)
    banner 'this is a banner, hello %s' world
    {
        typeset var
        print good
        try show echo 1 || tried
        { try show || tried; } <<'        EOF'
            cat <<EOF
                hello
            EOF
        EOF
        show cat <<< "Hello"
        show <<'        EOF'
            for i in {1..2}; do print $i; done
        EOF
    } always {
        caught
    } > >(indent)
    print done
    exit
    banner 'this is a banner, hello %s' world
    {
        integer err
        print good
        try -v err
        bad 2>&${err} || tried
    } always {
        caught
    } > >(indent)
    print okay
} $ZSH_EVAL_CONTEXT
