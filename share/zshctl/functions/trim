emulate -L zsh

# I don't want to have to type out this glob every time I want to trim while
# worrying about setting setopt.

set -- $1 ${2:-1} ${3:-1}

setopt localoptions extendedglob
[[ -v $1 ]] || return 1
(( $2 )) && : ${(P)1::=${${(P)1}##[[:space:]]##}} || :
(( $3 )) && : ${(P)1::=${${(P)1}%%[[:space:]]##}} || :
