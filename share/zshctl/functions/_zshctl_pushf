emulate -L zsh

# Pushes formatted strings onto an array by reference.
typeset array=${1:-} string
shift
printf -v string -- "$@"
# Same set, same order as _zshctl_mandown. The codepoint mapping is
# positional from U+E000 — if these diverge, characters restore wrong.
typeset -a _esc=( $'\\' '!' '"' '#' '$' '%' '&' "'" '(' ')' '*' '+' ',' '-' '.' '/' \
    ':' ';' '<' '=' '>' '?' '@' '[' ']' '^' '_' '`' '{' '|' '}' '~' )
integer _ei=0xE000
typeset _ec
for _ec in "${(@)_esc}"; do
    string=${string//${(#)_ei}/$_ec}
    (( _ei++ ))
done
set -A $array "${(@P)array}" "$string"
