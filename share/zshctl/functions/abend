emulate -L zsh

# Create a frame by finding an undefined variable.
set -- 0 "$@"
while true; do
    if [[ ! -v "__abend_$1__" ]]; then
        break
    fi
    set -- $(( $1 + 1 )) "$@[2,-1]"
done
# Set to actual variable name.
set -- "__abend_${1}__" "$@[2,-1]"
# Create frame.
typeset -a $1
# Reorder arguments.
function {
    typeset frame=$1
    integer code=1
    typeset -A ordered=()
    shift
    while (( $# )); do
        case $1 in
        (-c)
            code=$2
            shift 2
            ;;
        (-n)
            ordered[n]=$2
            shift 2
            ;;
        (-q)
            ordered[q]=1
            shift
            ;;
        (-f)
            ordered[f]=1
            break
            ;;
        (*)
            break
            ;;
        esac
    done
    typeset vargs=()
    for key in n q f; do
        (( ${+ordered[$key]} )) || continue
        case $key in
        (n)
            vargs+=( -$key "${ordered[n]}" )
            ;;
        (q|f)
            vargs+=( -$key )
            ;;
        esac
    done
    set -A $frame $code "${(@)vargs}" "$@"
} "$@"
set -- "${(@P)1}"
warn "$@[2,-1]"
exit $1
