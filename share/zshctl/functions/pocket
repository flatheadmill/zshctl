emulate -L zsh

# Assert that we got return variables and a command.
(( $# > 2 )) || {
    print 'usage: pocket out err echo 1'
    exit 1
}
[[ -v $1 ]] || {
    print 'out must be defined'
    exit 1
}
[[ ${(t)${(P)1}} = scalar-local ]] || {
    print 'out must be defined as a local scalar'
    exit 1
}
[[ -v $2 ]] || {
    print 'err must be defined'
    exit 1
}
[[ ${(t)${(P)2}} = scalar-local ]] || {
    print 'err must be defined as a local scalar'
    exit 1
}
# Create a frame by finding an undefined variable.
set -- 0 "$@"
while true; do
    if [[ ! -v "__pocket_$1__" ]]; then
        break
    fi
    set -- $(( $1 + 1 )) "$@[2,-1]"
done
# Set to actual variable name.
set -- "__pocket_${1}__" "$@[2,-1]"
# Define the variable.
typeset $1
# Create coprocs for standard out and standard error.
function {
    # We can use local variables here.
    typeset frame
    # Create the coprocs.
    integer output input try tried
    coproc {
        coproc :
        tac | tac
        printf '.'
    }
    exec {output}>&p
    exec {input}<&p
    coproc {
        coproc :
        tac | tac
        printf '.'
    }
    exec {try}>&p
    exec {tried}<&p
    coproc :
    # Return in our typeset variable.
    frame=( $output $try $input $tried "$@" )
    : ${(PA)1::=${(j: :)${(@qq)frame}}}
} "$@"
# Set our positional parameters from out one local variable.
set -- "${(@QA)${(z)${(P)1}}}"
# Unset our local variable and we are back to the state when this function
# was called.
unset $5
# Evaluate the users command in the current process with the current set of
# defined variables.
"${@[8,-1]}" >&$1 2>&$2
# Grab the exit code.
set -- $? "$@"
# Create our local variable so we don't shadow the out and err.
typeset -a $6
# Close our coprocs.
function {
    typeset frame=() out err output=$2 try=$3
    exec {output}>&-
    exec {try}>&-
    out="$(<&$4)" out=${out%.}
    err="$(<&$5)" err=${err%.}
    frame=( $1 "$7" "$out" "$8" "$err" )
    : ${(PA)6::=${(j: :)${(@qq)frame}}}
} "$@"
# Set our positional parameters from out one local variable.
set -- "${(@QA)${(z)${(P)6}}}"
# Set our return values.
: ${(P)2::=$3} ${(P)4::=$5}
# Return the exit code.
return $1
